{
  "name": "@lkti/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/node/main.ts --bundle --platform=node --target=node20 --format=esm --sourcemap --outfile=dist/server.mjs",
    "start": "node --enable-source-maps dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lkti/shared": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
